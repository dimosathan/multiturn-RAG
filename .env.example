# Copy to .env and fill in. Never commit .env.
# Each *_ENDPOINT is the full chat-completions URL of an Azure deployment.

# DeepSeek-V3.2 (Azure AI Foundry, serverless)  -> rewriting, span extraction, technical judge
AZURE_DS_ENDPOINT=https://<resource>.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview
AZURE_DS_KEY=

# GPT-4o (Azure OpenAI deployment)              -> answer generation, multi-judge gate
AZURE_GPT4O_ENDPOINT=https://<resource>.cognitiveservices.azure.com/openai/deployments/gpt-4o/chat/completions?api-version=2025-01-01-preview
AZURE_GPT4O_KEY=

# GPT-4o-mini (Azure OpenAI deployment)         -> user judge, refusals, micro-adjustments
AZURE_GPT4O_MINI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/openai/deployments/gpt-4o-mini/chat/completions?api-version=2025-01-01-preview
AZURE_GPT4O_MINI_KEY=

# Cohere Rerank v4 (Azure AI Foundry)
AZURE_COHERE_ENDPOINT=https://<resource>.services.ai.azure.com/providers/cohere/v2/rerank
AZURE_COHERE_KEY=

# Elasticsearch with ELSER v1 indices: either Elastic Cloud ...
ELASTICSEARCH_CLOUD_ID=
ELASTICSEARCH_PASSWORD=
# ... or a self-hosted cluster
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_API_KEY=
